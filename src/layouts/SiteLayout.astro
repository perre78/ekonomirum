---
/**
 * src/layouts/SiteLayout.astro
 * Ändring: stöd för root "/" som språk-hubb med egen canonical + x-default,
 * samt att loggan/brand-länken kan peka till "/" när man är på root.
 */
const {
  lang = "sv",
  title = "Ekonomirum i Karlstad",
  description = "Default description",
} = Astro.props;

const base = import.meta.env.BASE_URL;

// Språk-startsidor
const svUrl = `${base}sv/`;
const enUrl = `${base}en/`;
const plUrl = `${base}pl/`;
const ltUrl = `${base}lt/`;
const lvUrl = `${base}lv/`;
const etUrl = `${base}et/`;

// Root (ingångssida)
const rootUrl = `${base}`;

// Bygg absoluta URL:er (kräver att `site` är satt i astro.config.mjs)
const abs = (p: string) => new URL(p, Astro.site).toString();

// Root-läge: använd lang="root" på ingångssidan
const isRoot = lang === "root";

// Canonical
const canonical = isRoot
  ? abs(rootUrl)
  : lang === "sv"
    ? abs(svUrl)
    : lang === "en"
      ? abs(enUrl)
      : lang === "pl"
        ? abs(plUrl)
        : lang === "lt"
          ? abs(ltUrl)
          : lang === "lv"
            ? abs(lvUrl)
            : lang === "et"
              ? abs(etUrl)
              : abs(svUrl);

// Språk-hubben är samma x-default för hela hreflang-klustret.
const xDefault = abs(rootUrl);

// Brand-länk: root om root, annars respektive språk-start
const brandHref = isRoot
  ? rootUrl
  : lang === "sv"
    ? svUrl
    : lang === "pl"
      ? plUrl
      : lang === "lt"
        ? ltUrl
        : lang === "lv"
          ? lvUrl
          : lang === "et"
            ? etUrl
            : enUrl;

// html lang-attribut: på root sätter vi "en" (eller "sv" om du hellre vill)
const htmlLang = isRoot ? "en" : lang;

const languageMeta: Record<string, { flag: string; label: string }> = {
  sv: { flag: "🇸🇪", label: "Svenska" },
  en: { flag: "🇬🇧", label: "English" },
  pl: { flag: "🇵🇱", label: "Polski" },
  lt: { flag: "🇱🇹", label: "Lietuvių" },
  lv: { flag: "🇱🇻", label: "Latviešu" },
  et: { flag: "🇪🇪", label: "Eesti" },
};
const currentLanguage = languageMeta[lang] ?? { flag: "🌐", label: "Language" };
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Ekonomirum i Karlstad" />
    <meta name="application-name" content="Ekonomirum i Karlstad" />
    <meta name="apple-mobile-web-app-title" content="Ekonomirum i Karlstad" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="sv" href={abs(svUrl)} />
    <link rel="alternate" hreflang="en" href={abs(enUrl)} />
    <link rel="alternate" hreflang="pl" href={abs(plUrl)} />
    <link rel="alternate" hreflang="lt" href={abs(ltUrl)} />
    <link rel="alternate" hreflang="lv" href={abs(lvUrl)} />
    <link rel="alternate" hreflang="et" href={abs(etUrl)} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <style is:global>
      :root {
        --ink: #152338;
        --body-text: #425066;
        --surface: #fbfaf7;
        --surface-warm: #f4f1eb;
        --surface-accent: #edf5f2;
        --accent: #1f6f62;
        --accent-dark: #17564d;
        --line: #dcd8cf;
        --header-line: rgba(255, 255, 255, 0.13);
        --shadow: 0 22px 70px rgba(4, 12, 24, 0.3);
        --maxw: 960px;
        --contact-photo: 144px;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: rgba(255, 255, 255, 0.94);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; }

      .header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(16px);
        background: rgba(10, 22, 38, 0.82);
        border-bottom: 1px solid var(--header-line);
      }

      .header-inner {
        max-width: var(--maxw);
        min-height: 68px;
        margin: 0 auto;
        padding: 10px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        color: white;
        text-decoration: none;
      }

      .brand-text {
        font-weight: 760;
        font-size: 1.2rem;
        letter-spacing: 0.005em;
      }

      .language-menu { position: relative; }

      .language-menu summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 128px;
        padding: 9px 13px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: white;
        font-size: 0.9rem;
        font-weight: 650;
      }

      .language-menu summary::-webkit-details-marker { display: none; }
      .language-menu summary::after { content: "⌄"; margin-left: auto; opacity: 0.7; }
      .language-menu[open] summary::after { transform: rotate(180deg); }

      .language-options {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        min-width: 190px;
        padding: 8px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        background: #142338;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
      }

      .language-options a {
        display: flex;
        gap: 10px;
        padding: 9px 11px;
        border-radius: 10px;
        color: rgba(255, 255, 255, 0.88);
        text-decoration: none;
        font-size: 0.92rem;
      }

      .language-options a:hover,
      .language-options a[aria-current="page"] {
        color: white;
        background: rgba(255, 255, 255, 0.1);
      }

      .wrap {
        max-width: var(--maxw);
        margin: 42px auto;
        padding: 54px 58px;
        overflow: hidden;
        background: rgba(251, 250, 247, 0.97);
        color: var(--ink);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 28px;
        box-shadow: var(--shadow);
      }

      h1, h2 { color: var(--ink); line-height: 1.16; }

      h1 {
        max-width: 790px;
        margin: 0 0 22px;
        font-size: clamp(2.25rem, 5vw, 3.25rem);
        letter-spacing: -0.035em;
      }

      h2 {
        margin: 0 0 18px;
        font-size: clamp(1.45rem, 3vw, 1.9rem);
        letter-spacing: -0.02em;
      }

      p, li { color: var(--body-text); }
      p { max-width: 76ch; }

      .hero {
        padding: 6px 4px 46px;
      }

      .hero > p:first-of-type {
        max-width: 70ch;
        font-size: 1.08rem;
      }

      .hero h2 { margin-top: 38px; }

      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 15px;
        padding: 12px 18px;
        border-radius: 999px;
        background: var(--accent);
        color: white;
        box-shadow: 0 9px 24px rgba(31, 111, 98, 0.24);
        font-weight: 700;
        text-decoration: none;
        transition: background 0.18s ease, transform 0.18s ease;
      }

      .cta:hover { background: var(--accent-dark); transform: translateY(-1px); }

      .section {
        margin: 0;
        padding: 42px 4px;
        border-top: 1px solid var(--line);
      }

      .image-row {
        display: grid;
        grid-template-columns: 1.25fr 0.85fr;
        gap: 22px;
        align-items: end;
        margin: 32px 0 28px;
      }

      .image-row figure { margin: 0; }

      .image-row img {
        display: block;
        width: 100%;
        max-width: none;
        height: 290px;
        margin: 0;
        object-fit: cover;
        border-radius: 18px;
        box-shadow: 0 14px 34px rgba(20, 35, 56, 0.15);
      }

      .image-row figure:last-child img { height: 232px; }

      .image-row figcaption {
        margin-top: 9px;
        color: #667085;
        font-size: 0.83rem;
      }

      .address-list ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 36px;
        margin: 6px 0 0;
        padding: 0;
        list-style: none;
      }

      .address-list li {
        position: relative;
        min-height: 74px;
        padding: 15px 0 15px 28px;
        border-bottom: 1px solid var(--line);
      }

      .address-list li::before {
        content: "";
        position: absolute;
        top: 22px;
        left: 2px;
        width: 10px;
        height: 10px;
        border: 3px solid var(--accent);
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
      }

      .address-list a {
        display: block;
        width: fit-content;
        margin-top: 3px;
        color: var(--accent-dark);
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      #contact {
        margin-top: 34px;
        padding: 38px 42px;
        border: 1px solid #d4e6df;
        border-radius: 22px;
        background: var(--surface-accent);
      }

      .contact-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 28px;
        align-items: center;
        margin-top: 24px;
      }

      .contact-photo {
        display: block;
        width: var(--contact-photo) !important;
        max-width: var(--contact-photo) !important;
        height: auto !important;
        margin: 0 !important;
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(20, 35, 56, 0.16);
      }

      .contact-info { line-height: 1.6; }
      .contact-info strong { color: var(--ink); font-size: 1.08rem; }

      .contact-info a[href^="tel:"],
      .contact-info a[href^="mailto:"] {
        display: inline-flex;
        margin-top: 8px;
        padding: 8px 13px;
        border: 1px solid #bad5cc;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        color: var(--accent-dark);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
      }

      footer {
        max-width: var(--maxw);
        margin: 26px auto;
        padding: 0 20px 28px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
      }

      @media (max-width: 700px) {
        .header-inner { min-height: 60px; padding: 8px 16px; }
        .brand-text { font-size: 1.02rem; }
        .language-menu summary { min-width: 0; padding: 8px 11px; }
        .language-menu summary span:last-of-type { display: none; }

        .wrap {
          margin: 20px 10px;
          padding: 36px 22px;
          border-radius: 22px;
        }

        h1 { font-size: clamp(1.8rem, 8.5vw, 2.2rem); }
        h2 { font-size: 1.45rem; }
        .hero { padding-bottom: 34px; }
        .hero > p:first-of-type { font-size: 1rem; }
        .section { padding: 34px 0; }

        .image-row { grid-template-columns: 1fr; gap: 24px; }
        .image-row img,
        .image-row figure:last-child img { height: auto; aspect-ratio: 16 / 10; }

        .address-list ul { grid-template-columns: 1fr; }

        #contact { margin-top: 24px; padding: 30px 22px; }
        .contact-card { grid-template-columns: 1fr; text-align: center; }
        .contact-photo { margin: 0 auto !important; }
        .contact-info a[href^="tel:"],
        .contact-info a[href^="mailto:"] { justify-content: center; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .cta { transition: none; }
      }
    </style>
  </head>

  <body
    style={`
      background:
        radial-gradient(circle at 15% 10%, rgba(31, 111, 98, 0.22), transparent 34rem),
        radial-gradient(circle at 85% 70%, rgba(63, 92, 130, 0.20), transparent 38rem),
        linear-gradient(145deg, #0b1626 0%, #14253a 55%, #0d1c2c 100%);
      background-color: #0b1626;
    `}
  >
    <header class="header">
      <div class="header-inner">
        <a class="brand" href={brandHref}>
          <span class="brand-text">Ekonomirum i Karlstad</span>
        </a>

        <nav aria-label="Language selection">
          <details class="language-menu">
            <summary>
              <span aria-hidden="true">{currentLanguage.flag}</span>
              <span>{currentLanguage.label}</span>
            </summary>
            <div class="language-options">
              <a href={svUrl} aria-current={lang === "sv" ? "page" : undefined}>🇸🇪 Svenska</a>
              <a href={enUrl} aria-current={lang === "en" ? "page" : undefined}>🇬🇧 English</a>
              <a href={plUrl} aria-current={lang === "pl" ? "page" : undefined}>🇵🇱 Polski</a>
              <a href={ltUrl} aria-current={lang === "lt" ? "page" : undefined}>🇱🇹 Lietuvių</a>
              <a href={lvUrl} aria-current={lang === "lv" ? "page" : undefined}>🇱🇻 Latviešu</a>
              <a href={etUrl} aria-current={lang === "et" ? "page" : undefined}>🇪🇪 Eesti</a>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer>© {currentYear} – Ekonomirum i Karlstad</footer>
  </body>
</html>
